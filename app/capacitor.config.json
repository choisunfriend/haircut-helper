{
  "appId": "kr.gyeol.haircuthelper",
  "appName": "결 360shot",
  "webDir": "../dist",
  "bundledWebRuntime": false,
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    }
  }
}
